---
import BaseLayout from "../layouts/BaseLayout.astro";
import GroupPostCard from "../components/GroupPostCard.astro";
import SourceTags from "../components/SourceTags.astro";
import { groupPostCommentImageCount, groupPosts } from "../lib/groupPosts";
import { pageUrl } from "../lib/archive";

const years = [...new Set(groupPosts.map((post) => post.date.slice(0, 4)))].sort();
const imageCount = groupPosts.reduce((sum, post) => sum + post.saved_images.length, 0);
const commentCount = groupPosts.reduce((sum, post) => sum + (post.comments?.length || 0), 0);
const commentImageCount = groupPosts.reduce((sum, post) => sum + groupPostCommentImageCount(post), 0);
const description = `公開Facebookグループから保存したCode for SAITAMA関連投稿${groupPosts.length}件を、本文と写真でたどれるアーカイブです。`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Code for SAITAMA FBグループ投稿アーカイブ",
  url: pageUrl("posts.html"),
  inLanguage: "ja",
  description,
  numberOfItems: groupPosts.length
};
---
<BaseLayout title="FBグループ投稿" active="posts.html" description={description} jsonLd={jsonLd}>
  <section class="page-title">
    <p class="eyebrow">Facebook Group Archive</p>
    <h1>FBグループ投稿</h1>
    <p>公開グループから保存した投稿を、古い順に掲載しています。削除対象として目視確認済みの38投稿は除外しています。</p>
    <div class="source-legend"><SourceTags sources={["facebook-group"]} /><span>{groupPosts.length}投稿 · コメント{commentCount}件 · 投稿写真{imageCount}点 · コメント写真{commentImageCount}点 · {years[0]}–{years[years.length - 1]}</span></div>
  </section>

  <section class="post-controls" aria-label="投稿の絞り込み">
    <label>検索<input type="search" data-post-search placeholder="本文・投稿者・投稿ID" /></label>
    <label>年<select data-post-year><option value="">全年</option>{years.map((year) => <option value={year}>{year}年</option>)}</select></label>
    <label>並び順<select data-post-sort><option value="oldest">古い順</option><option value="newest">新しい順</option></select></label>
    <p><strong data-post-count>{groupPosts.length}</strong>件を表示</p>
  </section>

  <section class="group-post-list" data-post-list>
    {groupPosts.map((post) => <GroupPostCard post={post} />)}
  </section>

  <script>
    const list = document.querySelector<HTMLElement>("[data-post-list]");
    const search = document.querySelector<HTMLInputElement>("[data-post-search]");
    const year = document.querySelector<HTMLSelectElement>("[data-post-year]");
    const sort = document.querySelector<HTMLSelectElement>("[data-post-sort]");
    const count = document.querySelector<HTMLElement>("[data-post-count]");
    const cards = [...document.querySelectorAll<HTMLElement>("[data-post-card]")];

    function updatePosts() {
      const query = search?.value.trim().toLowerCase() || "";
      const selectedYear = year?.value || "";
      let visible = 0;
      for (const card of cards) {
        const matches = (!query || card.dataset.search?.includes(query)) && (!selectedYear || card.dataset.year === selectedYear);
        card.hidden = !matches;
        if (matches) visible += 1;
      }
      if (count) count.textContent = String(visible);
      if (list && sort?.value === "newest") cards.slice().reverse().forEach((card) => list.append(card));
      else if (list) cards.forEach((card) => list.append(card));
    }

    search?.addEventListener("input", updatePosts);
    year?.addEventListener("change", updatePosts);
    sort?.addEventListener("change", updatePosts);
  </script>
</BaseLayout>
