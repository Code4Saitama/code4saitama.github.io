---
import BaseLayout from "../layouts/BaseLayout.astro";
import SourceTags from "../components/SourceTags.astro";
import { getEvents, pageUrl } from "../lib/archive";

const events = await getEvents();
const themes = new Map<string, { label: string; events: typeof events }>();
for (const event of events) {
  event.data.themeKeys.forEach((key, index) => {
    if (!themes.has(key)) themes.set(key, { label: event.data.themes[index], events: [] });
    themes.get(key)?.events.push(event);
  });
}
const themeRows = [...themes.entries()].sort((a, b) => a[1].label.localeCompare(b[1].label, "ja"));
const description = "Code for SAITAMAの活動を、地図、オープンデータ、防災、学び、地域課題解決などのテーマ別に紹介しています。";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Code for SAITAMA テーマ別活動",
  url: pageUrl("themes.html"),
  inLanguage: "ja",
  description,
  about: themeRows.map(([, group]) => group.label),
  hasPart: themeRows.map(([key, group]) => ({
    "@type": "ItemList",
    name: group.label,
    url: `${pageUrl("themes.html")}#${key}`,
    numberOfItems: group.events.length
  }))
};
---
<BaseLayout title="テーマ別" active="themes.html" description={description} jsonLd={jsonLd}>
  <section class="page-title">
    <p class="eyebrow">Themes</p>
    <h1>テーマ別に見る</h1>
    <p>Code for SAITAMAの活動を、地図、データ、防災、学びなどの観点から見られるようにまとめています。</p>
  </section>
  {themeRows.map(([key, group]) => (
    <section class="theme-section" id={key}>
      <div class="section-head"><h2>{group.label}</h2><span>{group.events.length}件</span></div>
      <div class="compact-list">
        {group.events.sort((a, b) => a.data.sort - b.data.sort).map((event) => (
          event.data.hasDetail ? (
            <a href={event.data.page}><time>{event.data.date}</time><strong>{event.data.title}</strong><span><SourceTags sources={event.data.sources} /></span></a>
          ) : (
            <div class="theme-row"><time>{event.data.date}</time><strong>{event.data.title}</strong><span><SourceTags sources={event.data.sources} /></span></div>
          )
        ))}
      </div>
    </section>
  ))}
</BaseLayout>
