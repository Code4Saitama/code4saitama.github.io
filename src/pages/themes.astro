---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEvents } from "../lib/archive";

const events = await getEvents();
const themes = new Map<string, { label: string; events: typeof events }>();
for (const event of events) {
  event.data.themeKeys.forEach((key, index) => {
    if (!themes.has(key)) themes.set(key, { label: event.data.themes[index], events: [] });
    themes.get(key)?.events.push(event);
  });
}
const themeRows = [...themes.entries()].sort((a, b) => a[1].label.localeCompare(b[1].label, "ja"));
---
<BaseLayout title="テーマ別" active="themes.html">
  <section class="page-title">
    <p class="eyebrow">Themes</p>
    <h1>テーマ別に見る</h1>
    <p>活動のまとまりを、地図、データ、防災、学びなどの観点で整理しています。</p>
  </section>
  {themeRows.map(([key, group]) => (
    <section class="theme-section" id={key}>
      <div class="section-head"><h2>{group.label}</h2><span>{group.events.length}件</span></div>
      <div class="compact-list">
        {group.events.sort((a, b) => a.data.sort - b.data.sort).map((event) => (
          event.data.hasDetail ? (
            <a href={event.data.page}><time>{event.data.date}</time><strong>{event.data.title}</strong><span>詳細</span></a>
          ) : (
            <div class="theme-row"><time>{event.data.date}</time><strong>{event.data.title}</strong><span>年表のみ</span></div>
          )
        ))}
      </div>
    </section>
  ))}
</BaseLayout>
