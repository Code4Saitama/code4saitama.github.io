---
import BaseLayout from "../layouts/BaseLayout.astro";
import SourceTags from "../components/SourceTags.astro";
import { getNotes, getPage, noteArchivePath, pageUrl } from "../lib/archive";
import { archiveRecordImages, archiveRecordPath, referenceRecords } from "../lib/archiveRecords";

const { page, Content } = await getPage("research");
const notes = await getNotes();
const description = page.data.lead || "Code for SAITAMAの活動を補足する外部発表資料、GitHub、Code for Japanネットワーク、関連コミュニティの記録を整理したページです。";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: page.data.title,
  url: pageUrl("research.html"),
  inLanguage: "ja",
  description,
  about: "Code for SAITAMAの関連資料と補足記録",
  hasPart: notes.map((note) => ({
    "@type": "CreativeWork",
    name: note.data.title,
    datePublished: note.data.date,
    keywords: note.data.theme,
    sourceOrganization: note.data.source
  }))
};
---
<BaseLayout title="関連資料" active="research.html" description={description} jsonLd={jsonLd}>
  <section class="page-title research-title">
    <p class="eyebrow">{page.data.eyebrow}</p>
    <h1>{page.data.title}</h1>
    <p>{page.data.lead}</p>
  </section>
  <section class="text-page research-summary">
    <Content />
  </section>
  <section class="theme-section">
    <div class="section-head"><h2>関連資料から見える活動</h2><span>参考情報</span></div>
    <div class="research-list">
      {notes.map((note) => (
        <article><time>{note.data.date}</time><div><SourceTags sources={note.data.sources} /><h3><a href={noteArchivePath(note.id)}>{note.data.title}</a></h3><p>{note.body}</p></div></article>
      ))}
      {referenceRecords.map((record) => (
        <article><time>{record.date || "日付不明"}</time><div><SourceTags sources={record.sources} /><h3><a href={archiveRecordPath(record)}>{record.title}</a></h3><p>{record.summary}</p>{archiveRecordImages(record).length > 0 && <div class="archive-record-gallery">{archiveRecordImages(record).map((src) => <a href={archiveRecordPath(record)}><img src={src} alt="" loading="lazy" /></a>)}</div>}</div></article>
      ))}
    </div>
  </section>
</BaseLayout>
