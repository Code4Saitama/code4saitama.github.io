---
import BaseLayout from "../layouts/BaseLayout.astro";
import StatBand from "../components/StatBand.astro";
import { getEvents, getPage, pageUrl, siteOrigin } from "../lib/archive";
import imageManifest from "../../public/assets/images/images-manifest.json";

const events = await getEvents();
const { page, Content } = await getPage("about");
const description = page.data.lead || "Code for SAITAMAの団体紹介と、この公式アーカイブの掲載範囲を説明するページです。";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: page.data.title,
  url: pageUrl("about.html"),
  inLanguage: "ja",
  description,
  about: {
    "@type": "Organization",
    name: "Code for SAITAMA",
    url: siteOrigin,
    areaServed: "埼玉県",
    knowsAbout: ["シビックテック", "オープンデータ", "OpenStreetMap", "地域課題解決"]
  }
};
---
<BaseLayout title="紹介" active="about.html" description={description} jsonLd={jsonLd}>
  <section class="page-title about-title">
    <p class="eyebrow">{page.data.eyebrow}</p>
    <h1>{page.data.title}</h1>
    <p>{page.data.lead}</p>
  </section>
  <StatBand events={events} imageCount={imageManifest.length} />
  <section class="text-page">
    <Content />
  </section>
</BaseLayout>
