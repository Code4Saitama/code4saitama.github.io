---
import { render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { excerpt, getEvents, logoPath, siteImage, themeText } from "../lib/archive";

export async function getStaticPaths() {
  const events = await getEvents();
  return events
    .filter((event) => event.data.hasDetail)
    .map((event) => ({
      params: { slug: event.data.page.replace(/\.html$/, "") },
      props: { event }
    }));
}

const { event } = Astro.props;
const { Content } = await render(event);
const fb = event.data.fbid ? `https://www.facebook.com/events/${event.data.fbid}/` : "";
const heroImage = siteImage(event.data.image);
---
<BaseLayout title={event.data.title}>
  <article class="detail-page">
    <div class="detail-hero">
      {event.data.image ? (
        <img src={heroImage} alt="" loading="lazy" />
      ) : (
        <div class="verified-placeholder"><img src={logoPath} alt="Code for SAITAMA" loading="lazy" /></div>
      )}
      <div>
        <p class="eyebrow">Event / {event.data.date}</p>
        <h1>{event.data.title}</h1>
        <p>{excerpt(event.body || "", 210)}</p>
      </div>
    </div>
    <dl class="detail-meta">
      {event.data.start && <div><dt>開始</dt><dd>{event.data.start}</dd></div>}
      {event.data.end && <div><dt>終了</dt><dd>{event.data.end}</dd></div>}
      {event.data.place && <div><dt>場所</dt><dd>{event.data.place}</dd></div>}
      <div><dt>テーマ</dt><dd>{themeText(event.data.themes, event.data.themes.length)}</dd></div>
      {fb && <div><dt>Facebookイベント</dt><dd>{fb}</dd></div>}
    </dl>
    <section class="text-page">
      <h2>詳細</h2>
      <Content />
    </section>
    {event.data.images.length > 0 && (
      <section class="detail-gallery">
        {event.data.images.slice(0, 24).map((image, index) => (
          <figure><img src={siteImage(image)} alt="" loading="lazy" /><figcaption>関連写真 / {index + 1}</figcaption></figure>
        ))}
      </section>
    )}
  </article>
</BaseLayout>
