---
import { render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SourceTags from "../components/SourceTags.astro";
import { absoluteUrl, defaultOgImage, excerpt, getEvents, logoPath, pageUrl, schemaDateTime, siteImage, themeText } from "../lib/archive";
import { groupMediaPath, groupPosts, groupPostUrl } from "../lib/archiveRecords";

export async function getStaticPaths() {
  const events = await getEvents();
  return events.map((event) => ({
      params: { slug: event.data.page.replace(/\.html$/, "") },
      props: { event }
    }));
}

const { event } = Astro.props;
const { Content } = await render(event);
const fb = event.data.fbid ? `https://www.facebook.com/events/${event.data.fbid}/` : "";
const groupEventUrl = event.data.groupEventId && event.data.groupEventId !== event.data.fbid ? `https://www.facebook.com/events/${event.data.groupEventId}/` : "";
const relatedGroupPosts = groupPosts.filter((post) => event.data.groupPostIds.includes(String(post.id)));
const heroImage = siteImage(event.data.image);
const ogImage = event.data.image ? heroImage : defaultOgImage;
const description = excerpt(event.body || `${event.data.title}のイベント記録。`, 155);
const isOnline = `${event.data.title} ${event.body || ""} ${event.data.place || ""}`.includes("オンライン") || `${event.data.title} ${event.body || ""}`.includes("Discord");
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: event.data.title,
  url: pageUrl(event.data.page),
  description,
  startDate: schemaDateTime(event.data.start || event.data.date),
  endDate: schemaDateTime(event.data.end || ""),
  eventStatus: event.data.title.includes("中止") ? "https://schema.org/EventCancelled" : "https://schema.org/EventScheduled",
  eventAttendanceMode: isOnline ? "https://schema.org/OnlineEventAttendanceMode" : "https://schema.org/OfflineEventAttendanceMode",
  image: absoluteUrl(ogImage),
  organizer: {
    "@type": "Organization",
    name: "Code for SAITAMA",
    url: "https://www.code4saitama.org"
  },
  location: isOnline
    ? {
        "@type": "VirtualLocation",
        name: "オンライン"
      }
    : event.data.place
    ? {
        "@type": "Place",
        name: event.data.place,
        address: event.data.place
      }
    : undefined,
  keywords: event.data.themes.join(", "),
  sameAs: fb || undefined
};
---
<BaseLayout title={event.data.title} description={description} canonicalPath={event.data.page} image={ogImage} type="article" jsonLd={jsonLd}>
  <article class="detail-page">
    <div class="detail-hero">
      {event.data.image ? (
        <img src={heroImage} alt="" loading="lazy" />
      ) : (
        <div class="verified-placeholder"><img src={logoPath} alt="Code for SAITAMA" loading="lazy" /></div>
      )}
      <div>
        <p class="eyebrow">Event / {event.data.date}</p>
        <SourceTags sources={event.data.sources} />
        <h1>{event.data.title}</h1>
        <p>{excerpt(event.body || "", 210)}</p>
      </div>
    </div>
    <dl class="detail-meta">
      {event.data.start && <div><dt>開始</dt><dd>{event.data.start}</dd></div>}
      {event.data.end && <div><dt>終了</dt><dd>{event.data.end}</dd></div>}
      {event.data.place && <div><dt>場所</dt><dd>{event.data.place}</dd></div>}
      <div><dt>テーマ</dt><dd>{themeText(event.data.themes, event.data.themes.length)}</dd></div>
      {fb && <div><dt>Facebookイベント</dt><dd><a href={fb} target="_blank" rel="noopener">Facebookで開く</a></dd></div>}
      {groupEventUrl && <div><dt>FB Groupイベント</dt><dd><a href={groupEventUrl} target="_blank" rel="noopener">Facebookで開く</a></dd></div>}
      {relatedGroupPosts.length > 0 && <div><dt>FB Group投稿</dt><dd>{relatedGroupPosts.map((post, index) => <><a href={groupPostUrl(String(post.id))} target="_blank" rel="noopener">投稿{relatedGroupPosts.length > 1 ? ` ${index + 1}` : ""}</a>{index < relatedGroupPosts.length - 1 ? " / " : ""}</>)}</dd></div>}
    </dl>
    <section class="text-page">
      <h2>詳細</h2>
      {event.body ? <Content /> : <p>確認できた開催情報を、Code for SAITAMAの活動記録として整理しています。</p>}
    </section>
    {relatedGroupPosts.map((post, postIndex) => (
      <section class="text-page post-transcript">
        <div class="section-head inline-section-head">
          <h2>FB Group投稿{relatedGroupPosts.length > 1 ? ` ${postIndex + 1}` : ""}</h2>
          <a href={groupPostUrl(String(post.id))} target="_blank" rel="noopener">元の投稿を確認</a>
        </div>
        <p class="meta">{post.date}</p>
        <p class="preserve-lines">{post.text || post.summary}</p>
        {post.comments.length > 0 && (
          <div class="comments-section">
            <h3>コメント（{post.comments.length}件）</h3>
            <ol class="comment-list">
              {post.comments.map((comment) => (
                <li>
                  {comment.timestamp_label && <time>{comment.timestamp_label}</time>}
                  {(comment.text || comment.summary) && <p class="preserve-lines">{comment.text || comment.summary}</p>}
                  {comment.saved_images.length > 0 && <div class="comment-images">{comment.saved_images.map((image) => <img src={groupMediaPath(image)} alt="" loading="lazy" />)}</div>}
                </li>
              ))}
            </ol>
          </div>
        )}
      </section>
    ))}
    {event.data.images.length > 0 && (
      <section class="detail-gallery">
        {event.data.images.map((image, index) => (
          <figure><a href={siteImage(image)}><img src={siteImage(image)} alt="" loading="lazy" /></a><figcaption>関連写真 / {index + 1}</figcaption></figure>
        ))}
      </section>
    )}
  </article>
</BaseLayout>
