---
import BaseLayout from "../layouts/BaseLayout.astro";
import SourceTags from "../components/SourceTags.astro";
import { groupEventImage, groupEvents } from "../lib/groupEvents";
import { pageUrl } from "../lib/archive";

const years = [...new Set(groupEvents.map((event) => event.date.slice(0, 4)).filter(Boolean))].sort();
const detailedCount = groupEvents.filter((event) => event.detail_text).length;
const imageCount = groupEvents.reduce((sum, event) => sum + event.saved_images.length, 0);
const description = `Facebookグループに掲載されたイベント${groupEvents.length}件を、日時・場所・概要とともに保存したアーカイブです。`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Code for SAITAMA FBグループイベントアーカイブ",
  url: pageUrl("group-events.html"),
  inLanguage: "ja",
  description,
  numberOfItems: groupEvents.length
};
---
<BaseLayout title="FBグループイベント" active="group-events.html" description={description} jsonLd={jsonLd}>
  <section class="page-title">
    <p class="eyebrow">Facebook Group Events</p>
    <h1>FBグループイベント</h1>
    <p>グループの「イベント」欄と投稿内のイベントリンクを統合し、古い順に掲載しています。</p>
    <div class="source-legend"><SourceTags sources={["facebook-group"]} /><span>{groupEvents.length}件 · 詳細取得{detailedCount}件 · 写真{imageCount}点</span></div>
  </section>

  <section class="post-controls" aria-label="イベントの絞り込み">
    <label>検索<input type="search" data-event-search placeholder="イベント名・概要・場所" /></label>
    <label>年<select data-event-year><option value="">全年</option>{years.map((year) => <option value={year}>{year}年</option>)}</select></label>
    <label>並び順<select data-event-sort><option value="oldest">古い順</option><option value="newest">新しい順</option></select></label>
    <p><strong data-event-count>{groupEvents.length}</strong>件を表示</p>
  </section>

  <section class="group-event-grid" data-event-list>
    {groupEvents.map((event) => {
      const image = groupEventImage(event);
      const search = [event.title, event.summary, event.description, event.place, event.event_id].join(" ").toLowerCase();
      return (
        <article class="group-event-card" data-event-card data-year={event.date.slice(0, 4)} data-search={search}>
          {image && <a class="group-event-image" href={event.url} target="_blank" rel="noreferrer"><img src={image} alt="" loading="lazy" /></a>}
          <div class="group-event-copy">
            <div class="group-event-meta"><time>{event.date || "日付不明"}</time><SourceTags sources={["facebook-group"]} /></div>
            <h2><a href={event.url} target="_blank" rel="noreferrer">{event.title}</a></h2>
            {event.place && <p class="group-event-place">{event.place}</p>}
            <p>{event.summary || "イベント詳細はFacebookのリンクから確認できます。"}</p>
            <p class="group-event-links"><a href={event.url} target="_blank" rel="noreferrer">Facebookイベントを見る</a>{event.discovered_from_post_ids.length > 0 && <> · 関連投稿 {event.discovered_from_post_ids.length}件</>}</p>
          </div>
        </article>
      );
    })}
  </section>

  <script>
    const list = document.querySelector<HTMLElement>("[data-event-list]");
    const search = document.querySelector<HTMLInputElement>("[data-event-search]");
    const year = document.querySelector<HTMLSelectElement>("[data-event-year]");
    const sort = document.querySelector<HTMLSelectElement>("[data-event-sort]");
    const count = document.querySelector<HTMLElement>("[data-event-count]");
    const cards = [...document.querySelectorAll<HTMLElement>("[data-event-card]")];
    function updateEvents() {
      const query = search?.value.trim().toLowerCase() || "";
      const selectedYear = year?.value || "";
      let visible = 0;
      for (const card of cards) {
        const matches = (!query || card.dataset.search?.includes(query)) && (!selectedYear || card.dataset.year === selectedYear);
        card.hidden = !matches;
        if (matches) visible += 1;
      }
      if (count) count.textContent = String(visible);
      if (list && sort?.value === "newest") cards.slice().reverse().forEach((card) => list.append(card));
      else if (list) cards.forEach((card) => list.append(card));
    }
    search?.addEventListener("input", updateEvents);
    year?.addEventListener("change", updateEvents);
    sort?.addEventListener("change", updateEvents);
  </script>
</BaseLayout>
