---
import SourceTags from "./SourceTags.astro";
import { cleanGroupAuthor, groupPostCommentImageCount, groupImageUrl, groupPostExcerpt, groupPostPage, groupPostTitle, type GroupPost } from "../lib/groupPosts";

interface Props {
  post: GroupPost;
}

const { post } = Astro.props;
const title = groupPostTitle(post);
const page = groupPostPage(post);
const image = post.saved_images[0];
const commentCount = post.comments?.length || 0;
const commentImageCount = groupPostCommentImageCount(post);
const searchText = `${post.date} ${post.id} ${post.author} ${post.text} ${post.comments_summary || ""} ${(post.comments || []).map((comment) => `${comment.author} ${comment.text}`).join(" ")}`.toLowerCase();
---
<article class="group-post-card" data-post-card data-year={post.date.slice(0, 4)} data-search={searchText}>
  {image ? (
    <a class="group-post-thumb" href={page}><img src={groupImageUrl(image)} alt="" loading="lazy" /></a>
  ) : (
    <a class="group-post-thumb group-post-placeholder" href={page}>FB</a>
  )}
  <div class="group-post-copy">
    <p class="meta"><time datetime={post.date}>{post.date}</time> · {cleanGroupAuthor(post.author)}</p>
    <SourceTags sources={["facebook-group"]} />
    <h2><a href={page}>{title}</a></h2>
    <p>{groupPostExcerpt(post)}</p>
    <p class="group-post-assets">投稿ID {post.id} · 投稿写真 {post.saved_images.length}点 · コメント {commentCount}件 · コメント写真 {commentImageCount}点</p>
  </div>
</article>
