---
import { logoPath, noteArchivePath, siteImage, themeText } from "../lib/archive";
import SourceTags from "./SourceTags.astro";
import type { SourceKey } from "../lib/sources";

interface Props {
  item: {
    id: string;
    body?: string;
    data: {
      title: string;
      date: string;
      page?: string;
      themes?: string[];
      theme?: string;
      hasDetail?: boolean;
      source?: string;
      sources?: SourceKey[];
      image?: string;
    };
    kind: "イベント" | "補足";
  };
}

const { item } = Astro.props;
const theme = item.data.themes ? themeText(item.data.themes) : item.data.theme || "";
const image = item.data.image ? siteImage(item.data.image) : logoPath;
const isLogo = !item.data.image;
const isSupplemental = item.kind === "補足";
const href = item.kind === "イベント" && item.data.page ? `/${item.data.page}` : noteArchivePath(item.id);
---
<a class:list={["timeline-item", "compact-archive-row", { "is-supplemental": isSupplemental }]} href={href}>
  <time>{item.data.date}</time>
  <span class:list={["timeline-thumb", { "is-logo": isLogo }]}><img src={image} alt="" loading="lazy" /></span>
  <div>
    <p class="meta">{item.kind} · {theme}</p>
    <h3>{item.data.title}</h3>
    <SourceTags sources={item.data.sources} />
  </div>
</a>
