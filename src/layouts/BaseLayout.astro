---
import "../styles/global.css";
import { logoPath } from "../lib/archive";

interface Props {
  title: string;
  active?: string;
  bodyClass?: string;
}

const { title, active = "", bodyClass = "" } = Astro.props;
const navItems = [
  ["index.html", "トップ"],
  ["timeline.html", "時系列"],
  ["themes.html", "テーマ別"],
  ["research.html", "関連資料"],
  ["about.html", "紹介"]
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Code for SAITAMA Archive</title>
    <script defer src="/assets/site.js"></script>
  </head>
  <body class={bodyClass}>
    <header class="site-header">
      <a class="brand" href="index.html" aria-label="Code for SAITAMA アーカイブ">
        <img src={logoPath} alt="Code for SAITAMA" />
        <span>Archive</span>
      </a>
      <nav>
        {navItems.map(([href, label]) => <a class:list={[{ active: href === active }]} href={href}>{label}</a>)}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>Code for SAITAMA 公式アーカイブ</p>
      <p><a href="/docs/code-for-saitama-facebook-archive.md">アーカイブ資料</a> / <a href="/docs/deepresearch-code-for-saitama-analysis.md">関連資料メモ</a> / <a href="/assets/images/images-manifest.md">画像一覧</a></p>
    </footer>
  </body>
</html>
